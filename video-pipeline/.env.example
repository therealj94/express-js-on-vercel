# Copia a .env y edita. NUNCA commitear .env.
VAST_API_KEY=
HF_TOKEN=

# --- Selección de GPU ---
# Modo calidad  : RTX_PRO_6000_WS (96 GB, BF16 sin cuantizar, ~$0.67/h)  <- default
# Modo volumen  : RTX_5090 (~$0.35/h, INT8/FP8) + MIN_GPU_RAM=32
# Evitar        : A100_SXM4 (Ampere, emula FP8/FP4: más cara y más lenta)
GPU_NAME=RTX_PRO_6000_WS
MIN_GPU_RAM=90
NUM_GPUS=1
MAX_DPH=1.00            # USD/hora máximo
MIN_DISK=300            # GB
INTERRUPTIBLE=0         # 1 = permitir instancias interrumpibles (más baratas, riesgosas)

# Imagen: PyTorch + CUDA 12.8 (Blackwell). Para Ampere/Hopper sirve igual.
VAST_IMAGE=pytorch/pytorch:2.7.0-cuda12.8-cudnn9-devel
DISK_GB=350

# --- Pipeline ---
COMFY_PORT=8188
QUEUE_FILE=prompts/queue.json
REMOTE_OUT=/workspace/outputs
LOCAL_OUT=./outputs

# --- Costes / seguridad ---
MAX_SPEND_USD=25        # watchdog: destruye la instancia si se supera
AUTO_DESTROY=1          # 0 = solo descargar, no destruir

# --- Descarga opcional a nube (rclone remote ya configurado) ---
RCLONE_REMOTE=          # ej: gdrive:videos/h3
