 "capas": [
  {
   "tipo": "titulo",
   "t": 0.5,
   "dur": 2.2,
   "fundido": 0.7,
   "texto": "Un martes"
  },
  {
   "tipo": "nota",
   "t": 11.5,
   "dur": 6.0,
   "quien": "Sofía",
   "voz": "hija_1",
   "texto": "Ma, buen día… ya me cobraron la renta de este mes. Y fijate que los vuelos de diciembre todavía están baratos."
  },
  {
   "tipo": "narra",
   "t": 4.3,
   "dur": 1.05,
   "voz": "n01",
   "texto": "Me llamo Lucía."
  },
  {
   "tipo": "narra",
   "t": 5.4,
   "dur": 2.94,
   "voz": "n02",
   "texto": "Tengo un taller de tapicería, en San Salvador."
  },
  {
   "tipo": "narra",
   "t": 8.4,
   "dur": 2.54,
   "voz": "n03",
   "texto": "Mi hija, Sofía, estudia en Madrid."
  },
  {
   "tipo": "narra",
   "t": 17.9,
   "dur": 4.85,
   "voz": "n04",
   "texto": "Antes era una fila y días de espera. Ahora, desde la cocina."
  },
  {
   "tipo": "narra",
   "t": 22.8,
   "dur": 4.42,
   "voz": "n05",
   "texto": "Y ya le compré el boleto. En diciembre viene a casa."
  },
  {
   "tipo": "narra",
   "t": 27.4,
   "dur": 2.73,
   "voz": "n06",
   "texto": "En el barrio ya se paga así."
  },
  {
   "tipo": "narra",
   "t": 36.5,
   "dur": 9.47,
   "voz": "n07",
   "texto": "Y esto es mío. Se llama ONDK: una parte de Orden Global, la empresa detrás de todo esto."
  },
  {
   "tipo": "narra",
   "t": 46.6,
   "dur": 3.26,
   "voz": "n08",
   "texto": "Al mediodía, el cumpleaños de mi comadre Rosa."
  },
  {
   "tipo": "narra",
   "t": 51.3,
   "dur": 3.41,
   "voz": "n09",
   "texto": "Y la cuenta... que siempre era un lío."
  },
  {
   "tipo": "narra",
   "t": 55.0,
   "dur": 2.35,
   "voz": "n10",
   "texto": "Ahora, cada quien paga lo suyo."
  },
  {
   "tipo": "narra",
   "t": 57.4,
   "dur": 2.35,
   "voz": "n11",
   "texto": "Siempre hay uno que no se lo cree."
  },
  {
   "tipo": "narra",
   "t": 62.5,
   "dur": 1.54,
   "voz": "n12",
   "texto": "Pregúntale al dueño."
  },
  {
   "tipo": "narra",
   "t": 70.3,
   "dur": 2.45,
   "voz": "n13",
   "texto": "Mi proveedor de telas está en Honduras."
  },
  {
   "tipo": "narra",
   "t": 84.8,
   "dur": 3.25,
   "voz": "n14",
   "texto": "Otro país. Y el camión no espera."
  },
  {
   "tipo": "narra",
   "t": 97.6,
   "dur": 2.81,
   "voz": "n15",
   "texto": "Por fin, en casa."
  },
  {
   "tipo": "narra",
   "t": 107.0,
   "dur": 1.87,
   "voz": "n17",
   "texto": "Le contesté lo de siempre."
  },
  {
   "tipo": "narra",
   "t": 113.0,
   "dur": 4.11,
   "voz": "n18",
   "texto": "El dieciocho de diciembre... volvió a casa."
  },
  {
   "tipo": "narra",
   "t": 118.8,
   "dur": 2.29,
   "voz": "n19",
   "texto": "Y todo empezó un martes cualquiera."
  },
  {
   "tipo": "narra",
   "t": 121.6,
   "dur": 4.69,
   "voz": "n16",
   "texto": ""
