 "capas": [
  {
   "tipo": "nota",
   "t": 8.5,
   "dur": 6.0,
   "quien": "Sofía",
   "voz": "hija_1",
   "texto": "Ma, buen día… ya me cobraron la renta de este mes. Y fijate que los vuelos de diciembre todavía están baratos."
  },
  {
   "tipo": "narra",
   "t": 1.1,
   "dur": 1.15,
   "voz": "n01",
   "texto": "Me llamo Lucía."
  },
  {
   "tipo": "narra",
   "t": 2.3,
   "dur": 2.94,
   "voz": "n02",
   "texto": "Tengo un taller de tapicería, en San Salvador."
  },
  {
   "tipo": "narra",
   "t": 5.4,
   "dur": 2.54,
   "voz": "n03",
   "texto": "Mi hija, Sofía, estudia en Madrid."
  },
  {
   "tipo": "narra",
   "t": 14.9,
   "dur": 4.85,
   "voz": "n04",
   "texto": "Antes era una fila y días de espera. Ahora, desde la cocina."
  },
  {
   "tipo": "narra",
   "t": 19.8,
   "dur": 4.42,
   "voz": "n05",
   "texto": "Y ya le compré el boleto. En diciembre viene a casa."
  },
  {
   "tipo": "narra",
   "t": 24.4,
   "dur": 2.73,
   "voz": "n06",
   "texto": "En el barrio ya se paga así."
  },
  {
   "tipo": "narra",
   "t": 32.9,
   "dur": 7.25,
   "voz": "n07",
   "texto": "Y esto es mío. Se llama ONDK: una parte de Orden Global, la empresa detrás de todo esto."
  },
  {
   "tipo": "narra",
   "t": 40.2,
   "dur": 3.2,
   "voz": "n07b",
   "texto": "Tiene su acta, y la puedo abrir cuando quiera."
  },
  {
   "tipo": "narra",
   "t": 43.7,
   "dur": 2.33,
   "voz": "n08",
   "texto": "Martes de cumpleaños."
  },
  {
   "tipo": "narra",
   "t": 47.7,
   "dur": 3.25,
   "voz": "n09",
   "texto": "Y la cuenta... que siempre era un lío."
  },
  {
   "tipo": "narra",
   "t": 51.0,
   "dur": 2.67,
   "voz": "n10",
   "texto": "Ahora, cada quien paga lo suyo."
  },
  {
   "tipo": "narra",
   "t": 57.2,
   "dur": 2.35,
   "voz": "n11",
   "texto": "Siempre hay uno que no se lo cree."
  },
  {
   "tipo": "narra",
   "t": 62.5,
   "dur": 1.54,
   "voz": "n12",
   "texto": "Pregúntale al dueño."
  },
  {
   "tipo": "narra",
   "t": 69.7,
   "dur": 2.45,
   "voz": "n13",
   "texto": "Mi proveedor de telas está en Honduras."
  },
  {
   "tipo": "narra",
   "t": 82.5,
   "dur": 3.25,
   "voz": "n14",
   "texto": "Otro país. Y el camión no espera."
  },
  {
   "tipo": "narra",
   "t": 95.0,
   "dur": 2.59,
   "voz": "n15",
   "texto": "Un martes cualquiera."
  },
