//@version=5
// ═══════════════════════════════════════════════════════════════════════════
//  ORO SCALPING 3-EN-1 · v2 SCORE · VERSIÓN BACKTEST (strategy)
//  Misma lógica de score 0-100 que el indicador, para medir la probabilidad
//  real por umbral y por horario en el Probador de Estrategias.
//  Gestión: 50% en TP1 (1R) con SL a entrada, 50% en TP2 (2R).
// ═══════════════════════════════════════════════════════════════════════════
strategy("ORO Scalping 3-en-1 · Backtest v2", shorttitle="ORO 3en1 BT2", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_order, commission_value=0.5, calc_on_every_tick=false, process_orders_on_close=true)

tz       = input.string("America/New_York", "Zona horaria", options=["America/New_York", "UTC", "Europe/London"])
mode     = input.string("Solo killzones (recomendado)", "Horarios de operación", options=["Solo killzones (recomendado)", "Londres + NY completo", "24 horas"])
thr      = input.int(70, "Score mínimo para señal (1-100)", minval=40, maxval=95)
cooldown = input.int(12, "Velas mínimas entre señales", minval=0)

ldnKZ  = input.session("0300-0600", "Killzone Londres")
ldnORB = input.session("0300-0315", "Rango apertura Londres")
nyKZ   = input.session("0830-1130", "Killzone NY")
nyORB  = input.session("0830-0845", "Rango apertura NY")
lnSess = input.session("0200-1700", "Horario Londres+NY completo")

emaFastLen = input.int(9, "EMA rápida")
emaSlowLen = input.int(21, "EMA lenta")
emaBiasLen = input.int(200, "EMA sesgo")
htfTf      = input.timeframe("15", "TF superior")
rsiLen     = input.int(14, "RSI")
brkLen     = input.int(12, "Velas rango local")
adxLen     = input.int(14, "ADX")

atrLen   = input.int(14, "ATR")
swingLen = input.int(6, "Velas swing SL")
slBuf    = input.float(0.5, "Colchón SL (× ATR)")
maxSlAtr = input.float(1.5, "SL máximo (× ATR)")
rr1      = input.float(1.0, "TP1 (× riesgo)")
rr2      = input.float(2.0, "TP2 (× riesgo)")
closeEOD = input.bool(true, "Cerrar todo fuera de la ventana operable")

emaF = ta.ema(close, emaFastLen)
emaS = ta.ema(close, emaSlowLen)
emaB = ta.ema(close, emaBiasLen)
vwap = ta.vwap(hlc3)
rsi  = ta.rsi(close, rsiLen)
atr  = ta.atr(atrLen)
[diP, diM, adx] = ta.dmi(adxLen, adxLen)
htfF = request.security(syminfo.tickerid, htfTf, ta.ema(close, 21)[1], lookahead=barmerge.lookahead_off)
htfS = request.security(syminfo.tickerid, htfTf, ta.ema(close, 50)[1], lookahead=barmerge.lookahead_off)

inSess(s) => not na(time(timeframe.period, s, tz))

f_orb(sessRange) =>
    inR = inSess(sessRange)
    var float hi = na
    var float lo = na
    if inR and not inR[1]
        hi := high
        lo := low
    else if inR
        hi := math.max(hi, high)
        lo := math.min(lo, low)
    [hi, lo, inR]

[ldnHi, ldnLo, inLdnORB] = f_orb(ldnORB)
[nyHi,  nyLo,  inNyORB]  = f_orb(nyORB)

kzLdn = inSess(ldnKZ)
kzNY  = inSess(nyKZ)
kzActive = kzLdn or kzNY
inLdnNy  = inSess(lnSess)

orbHi      = kzNY ? nyHi : kzLdn ? ldnHi : na
orbLo      = kzNY ? nyLo : kzLdn ? ldnLo : na
orbForming = kzNY ? inNyORB : kzLdn ? inLdnORB : false
orbReady   = kzActive and not orbForming and not na(orbHi)

hhLocal = ta.highest(high, brkLen)[1]
llLocal = ta.lowest(low, brkLen)[1]

trendLongFull  = emaF > emaS and close > emaB
trendShortFull = emaF < emaS and close < emaB
brkLong  = kzActive ? (orbReady and close > orbHi) : close > hhLocal
brkShort = kzActive ? (orbReady and close < orbLo) : close < llLocal
candRange = math.max(high - low, syminfo.mintick)
candBull  = close > open and (close - open) / candRange >= 0.5
candBear  = close < open and (open - close) / candRange >= 0.5

ptsAdx  = math.min(adx, 40) / 40 * 10
ptsSess = kzActive ? 15.0 : inLdnNy ? 8.0 : 3.0

scLong  = (trendLongFull ? 20.0 : emaF > emaS ? 10.0 : 0.0) + (htfF > htfS ? 15.0 : 0.0) + (close > vwap ? 8.0 : 0.0) + (rsi > 50 ? 7.0 : 0.0) + (brkLong ? 15.0 : 0.0) + ptsAdx + ptsSess + (candBull ? 10.0 : 0.0)
scShort = (trendShortFull ? 20.0 : emaF < emaS ? 10.0 : 0.0) + (htfF < htfS ? 15.0 : 0.0) + (close < vwap ? 8.0 : 0.0) + (rsi < 50 ? 7.0 : 0.0) + (brkShort ? 15.0 : 0.0) + ptsAdx + ptsSess + (candBear ? 10.0 : 0.0)

tradeWindow = mode == "24 horas" ? true : mode == "Londres + NY completo" ? inLdnNy : kzActive

var int lastSig = na
canSignal = na(lastSig) or (bar_index - lastSig) > cooldown

longSignal  = tradeWindow and scLong  >= thr and scLong  > scShort and scLong[1]  < thr and canSignal
shortSignal = tradeWindow and scShort >= thr and scShort > scLong  and scShort[1] < thr and canSignal

swingLo = ta.lowest(low, swingLen)
swingHi = ta.highest(high, swingLen)
slLong  = math.max(swingLo - slBuf * atr, close - maxSlAtr * atr)
slShort = math.min(swingHi + slBuf * atr, close + maxSlAtr * atr)

var float entryPx = na
var float slPx    = na
var float tp1Px   = na
var float tp2Px   = na
var bool  tp1Hit  = false

if longSignal and strategy.position_size == 0
    lastSig := bar_index
    entryPx := close
    slPx    := slLong
    tp1Px   := close + rr1 * (close - slLong)
    tp2Px   := close + rr2 * (close - slLong)
    tp1Hit  := false
    strategy.entry("Long", strategy.long)

if shortSignal and strategy.position_size == 0
    lastSig := bar_index
    entryPx := close
    slPx    := slShort
    tp1Px   := close - rr1 * (slShort - close)
    tp2Px   := close - rr2 * (slShort - close)
    tp1Hit  := false
    strategy.entry("Short", strategy.short)

// Al tocar TP1: SL del resto a punto de entrada (break-even)
if strategy.position_size > 0 and not tp1Hit and high >= tp1Px
    tp1Hit := true
    slPx := entryPx
if strategy.position_size < 0 and not tp1Hit and low <= tp1Px
    tp1Hit := true
    slPx := entryPx

if strategy.position_size > 0
    strategy.exit("L-TP1", "Long", qty_percent=50, limit=tp1Px, stop=slPx)
    strategy.exit("L-TP2", "Long", limit=tp2Px, stop=slPx)
if strategy.position_size < 0
    strategy.exit("S-TP1", "Short", qty_percent=50, limit=tp1Px, stop=slPx)
    strategy.exit("S-TP2", "Short", limit=tp2Px, stop=slPx)

if closeEOD and not tradeWindow and strategy.position_size != 0
    strategy.close_all(comment="Fin de ventana")

plot(emaF, "EMA rápida", color=color.aqua)
plot(emaS, "EMA lenta", color=color.orange)
plot(emaB, "EMA sesgo", color=color.gray, linewidth=2)
plot(vwap, "VWAP", color=color.purple, linewidth=2)
plot(kzActive ? orbHi : na, "ORB alto", color=color.yellow, style=plot.style_linebr)
plot(kzActive ? orbLo : na, "ORB bajo", color=color.yellow, style=plot.style_linebr)
bgcolor(kzLdn ? color.new(color.blue, 94) : kzNY ? color.new(color.orange, 94) : na)
