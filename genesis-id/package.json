{
  "name": "genesis-id",
  "version": "2.0.0",
  "description": "Genesis ID — identidad digital del ecosistema Orden Global: KYC, KYB, tamizado de sanciones, monitoreo AML e inicio de sesión único",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "prueba": "node --import tsx --test --test-force-exit src/pruebas/*.test.ts src/pruebas/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "construir:firma": "esbuild src/credencial/navegador/firma.js --bundle --format=iife --minify --target=es2020 --outfile=public/lib/firma.js"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mongodb": "^7.5.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "ethers": "^6.17.0",
    "mongodb-memory-server": "^10.2.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
