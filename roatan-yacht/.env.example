# Admin sign-in. Change this before the site is reachable by anyone else.
ADMIN_PASSWORD=lovecloud

# Card payments. Leave blank to run in quote mode (bookings confirmed, invoiced by hand).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email. Leave blank and every message is printed to the server log instead,
# which is how you check the wording before anything reaches a customer.
RESEND_API_KEY=
MAIL_FROM=reservations@lovecloudroatan.com

# Canonical origin, used for Stripe redirects and invoice links.
PUBLIC_URL=

# Postgres. Set this in production — without it the app keeps everything in a
# local JSON file, which a serverless host forgets on every restart.
# Works with Neon, Supabase, Railway, RDS: postgres://user:pass@host/db
DATABASE_URL=

# Where db.json is written when there is no DATABASE_URL. Must be writable.
DATA_DIR=

PORT=3000
