# Admin sign-in. Change this before the site is reachable by anyone else.
ADMIN_PASSWORD=lovecloud

# Card payments. Leave blank to run in quote mode (bookings confirmed, invoiced by hand).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Canonical origin, used for Stripe redirects and invoice links.
PUBLIC_URL=

# Where db.json is written. Must be writable.
DATA_DIR=

PORT=3000
