{
  "version": 2,
  "builds": [
    { "src": "server/index.js", "use": "@vercel/node", "config": { "includeFiles": ["public/**"] } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/index.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*\\.(css|js|png|jpg|jpeg|svg|ico|webp|woff2))", "dest": "/public/$1" },
    { "src": "/(.*\\.html)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "server/index.js" }
  ]
}
