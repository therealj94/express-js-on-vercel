//@version=6
// =====================================================================================
//  FENIX FF GOLD SIGNALS v3 — Señales + Guía paso a paso para cualquier nivel
//  XAUUSD y cualquier activo · Pine Script v6 · todas las temporalidades (auto-tuning)
//
//  QUÉ HACE:
//   · Motor Fallo del Fallo (L → F → M → entrada) en ambas direcciones a la vez.
//   · MODO GUÍA: tabla en español simple que dice qué está haciendo el precio
//     (acumulación, tendencia, dormido), en qué PASO 1/4-4/4 va cada dirección y
//     qué hay que esperar ahora. Fondo naranja suave cuando hay acumulación.
//   · PUNTAJE 0-100 (8 confluencias) + PROBABILIDAD %: estimada al inicio y REAL
//     (winrate histórico por nota) cuando esa nota acumula operaciones cerradas.
//   · CHECKLIST de confluencias impreso en cada señal (MTF✓ FC✓ VOL✗ ...).
//   · AVISO "PREPARAR" al crearse la ineficiencia, con entrada/SL/TP planificados.
//   · LOTE SUGERIDO según tu capital y % de riesgo.
//   · CHEQUEO DE CAMINO LIBRE: avisa si hay una zona FC opuesta antes del TP.
//   · GESTOR DE OPERACIÓN: cajas riesgo/recompensa; al tocar SL o TP se cierra sola
//     y queda como HISTORIAL: ✔ TP +R / ✘ SL -1R. Si SL y TP se tocan en la misma
//     vela cuenta como SL (regla conservadora). Solo una operación a la vez.
//   · PANEL: trade activo, historial, winrate, R neto, racha y winrate POR NOTA.
// =====================================================================================

indicator("FENIX FF GOLD SIGNALS — Probabilidad + Guía", shorttitle="FENIX FF SIGNALS", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// =====================================================================================
// ① AUTO-ADAPTACIÓN A LA TEMPORALIDAD
// =====================================================================================
grpAuto = "① Auto-adaptación"
autoTf  = input.bool(true, "Auto-adaptar parámetros a la temporalidad", group=grpAuto, tooltip="Ajusta fractal, cuerpo, ineficiencia, tolerancia, cooldown y MTF según 1m/3m/5m/15m/1h/4h+.")
tfMin   = timeframe.in_seconds(timeframe.period) / 60.0

autoPivot = tfMin <= 1 ? 5   : tfMin <= 3 ? 5    : tfMin <= 5 ? 6    : tfMin <= 15 ? 8    : tfMin <= 60 ? 10   : 12
autoDisp  = tfMin <= 1 ? 0.45: tfMin <= 3 ? 0.48 : tfMin <= 5 ? 0.50 : tfMin <= 15 ? 0.55 : tfMin <= 60 ? 0.55 : 0.50
autoFvg   = tfMin <= 1 ? 0.10: tfMin <= 3 ? 0.12 : tfMin <= 5 ? 0.14 : tfMin <= 15 ? 0.18 : tfMin <= 60 ? 0.20 : 0.20
autoTol   = tfMin <= 1 ? 0.35: tfMin <= 3 ? 0.32 : tfMin <= 5 ? 0.30 : tfMin <= 15 ? 0.25 : 0.22
autoCool  = tfMin <= 1 ? 3   : tfMin <= 5 ? 4    : 5
autoHtf   = tfMin <= 1 ? "15": tfMin <= 3 ? "30" : tfMin <= 5 ? "30" : tfMin <= 15 ? "60" : tfMin <= 60 ? "240": "D"

// =====================================================================================
// ② MOTOR FALLO DEL FALLO
// =====================================================================================
grpFF = "② Fallo del Fallo"
pivotIn      = input.int(8,     "Fractal (pivot) lookback",            minval=2, maxval=50, group=grpFF)
sweepMaxAge  = input.int(120,   "Vida máxima del pivot (velas)",       minval=10, maxval=500, group=grpFF)
tolIn        = input.float(0.25,"Tolerancia lógica tendencial (x ATR)", minval=0.0, maxval=2.0, step=0.05, group=grpFF)
awayAtr      = input.float(0.30,"Alejamiento previo a mitigación (x ATR)", minval=0.0, maxval=3.0, step=0.05, group=grpFF)
dispIn       = input.float(0.55,"Cuerpo mínimo de impulso (x ATR)",    minval=0.1, maxval=3.0, step=0.05, group=grpFF)
minImpulse   = input.int(2,     "Velas de estiramiento mínimas",       minval=1, maxval=5, group=grpFF)
requireBOS   = input.bool(true, "Exigir desplazamiento estructural",   group=grpFF)
minFvgIn     = input.float(0.18,"Ineficiencia mínima (x ATR)",         minval=0.0, maxval=2.0, step=0.02, group=grpFF)
entryMode    = input.string("Confirmación", "Disparo de entrada", options=["Toque", "Confirmación"], group=grpFF)
fvgFillMode  = input.string("50% (mitad de la ineficiencia)", "Nivel de rebalanceo", options=["Borde (primer toque)", "50% (mitad de la ineficiencia)", "Relleno total"], group=grpFF)
maxWaitMitig = input.int(25,    "Máx. velas esperando mitigación",     minval=3, maxval=200, group=grpFF)
maxWaitExp   = input.int(20,    "Máx. velas esperando estiramiento",   minval=2, maxval=200, group=grpFF)
maxWaitRetest= input.int(40,    "Máx. velas esperando rebalanceo",     minval=2, maxval=300, group=grpFF)

// =====================================================================================
// ③ PUNTAJE Y PROBABILIDAD
// =====================================================================================
grpScore = "③ Puntaje y probabilidad"
minScore   = input.int(50,  "Puntaje mínimo para dar señal (0-100)", minval=0, maxval=100, group=grpScore, tooltip="50 = filtra las señales de nota C. 65 = solo A y A+. 80 = solo A+.")
wMtf       = input.int(25,  "Peso · sesgo MTF alineado",           minval=0, maxval=50, group=grpScore)
wZone      = input.int(15,  "Peso · entrada en zona FC viva",      minval=0, maxval=50, group=grpScore)
wAcum      = input.int(10,  "Peso · acumulación dominante",        minval=0, maxval=50, group=grpScore)
wSess      = input.int(10,  "Peso · killzone Londres/NY",          minval=0, maxval=50, group=grpScore)
wVol       = input.int(10,  "Peso · volumen sobre la media",       minval=0, maxval=50, group=grpScore)
wImp       = input.int(10,  "Peso · impulso extra (3+ velas)",     minval=0, maxval=50, group=grpScore)
wFvg       = input.int(10,  "Peso · ineficiencia amplia",          minval=0, maxval=50, group=grpScore)
wRep       = input.int(10,  "Peso · nivel repetido",               minval=0, maxval=50, group=grpScore)
repTolPct  = input.float(0.5,"Tolerancia nivel repetido (%)",      minval=0.05, maxval=3.0, step=0.05, group=grpScore)
minProbN   = input.int(10,  "Operaciones mínimas para usar winrate real por nota", minval=3, maxval=100, group=grpScore, tooltip="Hasta llegar a este número, la P%% mostrada es una estimación calibrada por puntaje. Desde ahí, es el winrate histórico real de esa nota.")

// =====================================================================================
// ④ OPERACIÓN, RIESGO E HISTORIAL
// =====================================================================================
grpTrade = "④ Operación, riesgo e historial"
atrLen     = input.int(14,    "ATR length",                          minval=2, maxval=100, group=grpTrade)
slBuffAtr  = input.float(0.20,"Colchón del SL (x ATR)",              minval=0.0, maxval=2.0, step=0.05, group=grpTrade)
rr1        = input.float(2.0, "TP en múltiplo de R",                 minval=0.5, maxval=20, step=0.5, group=grpTrade)
maxTradeBars = input.int(150, "Máx. velas por operación",            minval=10, maxval=1000, group=grpTrade, tooltip="Si no toca SL ni TP en este tiempo, se cierra al precio actual y se registra el R real.")
keepHistory  = input.bool(true,"Congelar operaciones cerradas como historial", group=grpTrade)
capUSD     = input.float(10000,"Capital de la cuenta (USD)",         minval=10, group=grpTrade)
riskPctIn  = input.float(1.0, "Riesgo por operación (%)",            minval=0.05, maxval=10, step=0.05, group=grpTrade)
usdPerPt   = input.float(1.0, "USD por punto por lote",              minval=0.0001, group=grpTrade, tooltip="XAUUSD: lote de 1 oz = 1 USD por punto de movimiento; lote de 100 oz = 100.")
showCheck  = input.bool(true, "Mostrar checklist de confluencias",   group=grpTrade)
showPrep   = input.bool(true, "Aviso PREPARAR al crearse la ineficiencia", group=grpTrade)

// =====================================================================================
// ⑤ FILTROS
// =====================================================================================
grpFilter = "⑤ Filtros"
useSession   = input.bool(false,"Filtrar señales por sesión",         group=grpFilter, tooltip="Aunque esté apagado, la killzone sigue sumando puntos al puntaje.")
sess1        = input.session("0700-1030", "Killzone Londres",         group=grpFilter)
sess2        = input.session("1230-1600", "Killzone Nueva York",      group=grpFilter)
tzInput      = input.string("UTC", "Zona horaria de las sesiones",    group=grpFilter)
useHtfBias   = input.bool(false,"Bloquear señales contra el MTF",     group=grpFilter, tooltip="Apagado: el MTF solo puntúa (recomendado, deja medir en el historial). Encendido: además bloquea.")
htfIn        = input.timeframe("30", "Temporalidad mayor",            group=grpFilter)
htfEmaLen    = input.int(50,    "EMA de sesgo en HTF",                minval=5, maxval=400, group=grpFilter)
useVolFilter = input.bool(true, "Filtro de volatilidad mínima",       group=grpFilter)
minAtrPct    = input.float(0.02,"ATR mínimo (% del precio)",          minval=0.0, maxval=1.0, step=0.01, group=grpFilter)
coolIn       = input.int(5,     "Cooldown entre señales (velas)",     minval=0, maxval=100, group=grpFilter)

// =====================================================================================
// ⑥ ZONAS FC (confluencia + visual)
// =====================================================================================
grpFC = "⑥ Zonas FC"
showFC     = input.bool(true,  "Marcar etiquetas FC",                 group=grpFC)
fcSens     = input.string("Baja (solo fuertes)", "Sensibilidad FC", options=["Alta (todos)", "Media", "Baja (solo fuertes)"], group=grpFC)
showFCLine = input.bool(true,  "Trazar líneas de zona FC",            group=grpFC)
fcExtend   = input.int(60,     "Extensión de la línea (velas)",       minval=5, maxval=500, group=grpFC)
maxZones   = input.int(20,     "Máx. zonas vivas por lado",           minval=5, maxval=100, group=grpFC)
keepLiq    = input.bool(false, "Dejar rastro de zona liquidada",      group=grpFC)
colFCBull  = input.color(#00E676, "Color FC alcista",                 group=grpFC)
colFCBear  = input.color(#FF1744, "Color FC bajista",                 group=grpFC)

// =====================================================================================
// ⑦ ACUMULACIÓN
// =====================================================================================
grpAcc = "⑦ F+F en Acumulación"
accEnable  = input.bool(true, "Detectar acumulación",                 group=grpAcc)
accLen     = input.int(30,    "Ventana del rango (velas)",            minval=10, maxval=200, group=grpAcc)
accMaxAtr  = input.float(4.5, "Ancho máximo del rango (x ATR)",       minval=1.0, maxval=20, step=0.5, group=grpAcc)
accOnlyDom = input.bool(true, "Operar solo el extremo dominante",     group=grpAcc)

// =====================================================================================
// ⑧ VISUAL
// =====================================================================================
grpUi = "⑧ Visual y panel"
showPanel  = input.bool(true, "Mostrar panel de estadísticas",        group=grpUi)
panelPos   = input.string("Superior derecha", "Posición del panel", options=["Superior derecha", "Superior izquierda", "Inferior derecha", "Inferior izquierda"], group=grpUi)
panelSize  = input.string("Grande", "Tamaño del panel", options=["Normal", "Grande"], group=grpUi)
showPhases = input.bool(true, "Mostrar fases en el gráfico",          group=grpUi)
showZonesB = input.bool(true, "Mostrar caja de ineficiencia",         group=grpUi)
colBull    = input.color(#2962FF, "Color señal alcista",              group=grpUi)
colBear    = input.color(#E91E63, "Color señal bajista",              group=grpUi)
colHeader  = input.color(#C9A227, "Color cabecera del panel",         group=grpUi)

// =====================================================================================
// ⑨ MODO GUÍA (para principiantes)
// =====================================================================================
grpGuide = "⑨ Modo guía"
showGuide  = input.bool(true, "Mostrar guía ¿QUÉ PASA AHORA?",        group=grpGuide, tooltip="Tabla en español simple: qué hace el precio, en qué paso va el patrón y qué esperar.")
guidePos   = input.string("Inferior izquierda", "Posición de la guía", options=["Superior derecha", "Superior izquierda", "Inferior derecha", "Inferior izquierda"], group=grpGuide)
easyLabels = input.bool(true, "Etiquetas explicativas (1·Barrido, 2·Mitigado...)", group=grpGuide)
accShade   = input.bool(true, "Sombrear el fondo cuando hay acumulación", group=grpGuide)

// =====================================================================================
// PARÁMETROS EFECTIVOS
// =====================================================================================
pivotLen  = autoTf ? autoPivot : pivotIn
dispMult  = autoTf ? autoDisp  : dispIn
minFvgAtr = autoTf ? autoFvg   : minFvgIn
tolAtr    = autoTf ? autoTol   : tolIn
cooldown  = autoTf ? autoCool  : coolIn
htfTf     = autoTf ? autoHtf   : htfIn

// =====================================================================================
// CÁLCULOS BASE
// =====================================================================================
atr     = ta.atr(atrLen)
bodySz  = math.abs(close - open)
rng     = high - low
bullBar = close > open
bearBar = close < open
volSma  = ta.sma(volume, 20)
volHigh = volume > volSma

inSess1   = not na(time(timeframe.period, sess1, tzInput))
inSess2   = not na(time(timeframe.period, sess2, tzInput))
inKill    = inSess1 or inSess2
sessionOk = not useSession or inKill

atrPct = close != 0 ? atr / close * 100 : 0.0
volOk  = not useVolFilter or atrPct >= minAtrPct

htfClose = request.security(syminfo.tickerid, htfTf, close, lookahead=barmerge.lookahead_off)
htfOpen  = request.security(syminfo.tickerid, htfTf, open,  lookahead=barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)

memoryBull = htfClose > htfOpen
memoryBear = htfClose < htfOpen
biasBull   = htfClose > htfEma and memoryBull
biasBear   = htfClose < htfEma and memoryBear
htfOkLong  = not useHtfBias or biasBull
htfOkShort = not useHtfBias or biasBear

allowLong  = sessionOk and volOk and htfOkLong
allowShort = sessionOk and volOk and htfOkShort

// =====================================================================================
// CAPA · ZONAS FC
// =====================================================================================
fcMinRng = fcSens == "Alta (todos)" ? 0.0 : fcSens == "Media" ? 0.30 * atr : 0.60 * atr
fcBull   = low < low[1] and close > close[1] and close > open and rng >= fcMinRng
fcBear   = high > high[1] and close < close[1] and close < open and rng >= fcMinRng

var array<float> zbLvl = array.new<float>()
var array<line>  zbLn  = array.new<line>()
var array<int>   zbBar = array.new<int>()
var array<float> zsLvl = array.new<float>()
var array<line>  zsLn  = array.new<line>()
var array<int>   zsBar = array.new<int>()
var int fcBullLiq = 0
var int fcBearLiq = 0

if fcBull
    line lnB = na
    if showFCLine
        lnB := line.new(bar_index, low, bar_index + fcExtend, low, color=color.new(colFCBull, 30), width=2)
    array.push(zbLvl, low)
    array.push(zbLn,  lnB)
    array.push(zbBar, bar_index)
    if showFC
        label.new(bar_index, low, "FC", style=label.style_label_up, color=color.new(colFCBull, 20), textcolor=color.black, size=size.tiny, tooltip="Zona de demanda: aquí el precio falló al bajar")
    if array.size(zbLvl) > maxZones
        line oldB = array.shift(zbLn)
        array.shift(zbLvl)
        array.shift(zbBar)
        if not na(oldB)
            line.delete(oldB)

if fcBear
    line lnS = na
    if showFCLine
        lnS := line.new(bar_index, high, bar_index + fcExtend, high, color=color.new(colFCBear, 30), width=2)
    array.push(zsLvl, high)
    array.push(zsLn,  lnS)
    array.push(zsBar, bar_index)
    if showFC
        label.new(bar_index, high, "FC", style=label.style_label_down, color=color.new(colFCBear, 20), textcolor=color.white, size=size.tiny, tooltip="Zona de oferta: aquí el precio falló al subir")
    if array.size(zsLvl) > maxZones
        line oldS = array.shift(zsLn)
        array.shift(zsLvl)
        array.shift(zsBar)
        if not na(oldS)
            line.delete(oldS)

if array.size(zbLvl) > 0
    for i = array.size(zbLvl) - 1 to 0
        lvlB  = array.get(zbLvl, i)
        lin3  = array.get(zbLn,  i)
        barB  = array.get(zbBar, i)
        if low <= lvlB and bar_index > barB
            fcBullLiq += 1
            if not na(lin3)
                if keepLiq
                    line.set_x2(lin3, bar_index)
                    line.set_style(lin3, line.style_dotted)
                    line.set_color(lin3, color.new(colFCBull, 70))
                    line.set_width(lin3, 1)
                else
                    line.delete(lin3)
            array.remove(zbLvl, i)
            array.remove(zbLn,  i)
            array.remove(zbBar, i)
        else if not na(lin3)
            line.set_x2(lin3, bar_index + math.min(fcExtend, 20))

if array.size(zsLvl) > 0
    for i = array.size(zsLvl) - 1 to 0
        lvlS  = array.get(zsLvl, i)
        lin4  = array.get(zsLn,  i)
        barS  = array.get(zsBar, i)
        if high >= lvlS and bar_index > barS
            fcBearLiq += 1
            if not na(lin4)
                if keepLiq
                    line.set_x2(lin4, bar_index)
                    line.set_style(lin4, line.style_dotted)
                    line.set_color(lin4, color.new(colFCBear, 70))
                    line.set_width(lin4, 1)
                else
                    line.delete(lin4)
            array.remove(zsLvl, i)
            array.remove(zsLn,  i)
            array.remove(zsBar, i)
        else if not na(lin4)
            line.set_x2(lin4, bar_index + math.min(fcExtend, 20))

zoneNear   = 0.35 * atr
inBullZone = false
inBearZone = false
if array.size(zbLvl) > 0
    for i = 0 to array.size(zbLvl) - 1
        if math.abs(close - array.get(zbLvl, i)) <= zoneNear
            inBullZone := true
if array.size(zsLvl) > 0
    for i = 0 to array.size(zsLvl) - 1
        if math.abs(close - array.get(zsLvl, i)) <= zoneNear
            inBearZone := true

// =====================================================================================
// MOTOR F+F · DOS MÁQUINAS
// =====================================================================================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,   pivotLen, pivotLen)

var float lastPH    = na
var int   lastPHBar = na
var bool  phUsed    = false
var float lastPL    = na
var int   lastPLBar = na
var bool  plUsed    = false

if not na(ph)
    lastPH    := ph
    lastPHBar := bar_index - pivotLen
    phUsed    := false
if not na(pl)
    lastPL    := pl
    lastPLBar := bar_index - pivotLen
    plUsed    := false

var int   bSt      = 0
var float bFcLo    = na
var float bFcHi    = na
var int   bStBar   = na
var bool  bAway    = false
var float bStruct  = na
var float bFvgTop  = na
var float bFvgBot  = na
var float bTrig    = na
var int   bImp     = 0
var int   bImpSave = 0
var float bFvgQual = 0.0
var box   bFvgBox  = na

var int   sSt      = 0
var float sFcLo    = na
var float sFcHi    = na
var int   sStBar   = na
var bool  sAway    = false
var float sStruct  = na
var float sFvgTop  = na
var float sFvgBot  = na
var float sTrig    = na
var int   sImp     = 0
var int   sImpSave = 0
var float sFvgQual = 0.0
var box   sFvgBox  = na

var int lastSigBar = na

bool markL_L = false
bool markL_S = false
bool markF_L = false
bool markF_S = false
bool markM_L = false
bool markM_S = false
bool buyRdy  = false
bool sellRdy = false

accHi   = ta.highest(high, accLen)
accLo   = ta.lowest(low,   accLen)
inAccum = accEnable and atr > 0 and (accHi - accLo) <= accMaxAtr * atr

tol    = tolAtr * atr
coolOk = na(lastSigBar) or bar_index - lastSigBar >= cooldown

// estado de la operación virtual (se declara antes porque bloquea señales nuevas)
var int   tDir   = 0
var float tEntry = na
var float tSl    = na
var float tTp    = na
var int   tBar   = na
var int   tScore = 0
var box   tRisk  = na
var box   tRew   = na

flat = tDir == 0

// ————— máquina alcista —————
if bSt == 0
    freshPL = not na(lastPL) and not plUsed and bar_index - lastPLBar <= sweepMaxAge
    if freshPL and low < lastPL and close > lastPL and allowLong
        bSt     := 1
        bFcLo   := low
        bFcHi   := math.max(open, close)
        bStruct := low
        bStBar  := bar_index
        bImp    := 0
        bAway   := false
        plUsed  := true
        markL_L := true

else if bSt == 1
    if low < bFcLo - tol
        bSt := 0
    else
        if low < bFcLo
            bStruct := low
        if high > bFcHi + awayAtr * atr
            bAway := true
        if bAway and low <= bFcHi
            bSt     := 2
            bStBar  := bar_index
            bImp    := 0
            markF_L := true
        else if bar_index - bStBar > maxWaitMitig
            bSt := 0

else if bSt == 2
    if low < bStruct - tol
        bSt := 0
    else
        bImp := bullBar and bodySz >= dispMult * atr ? bImp + 1 : 0
        fvgOk   = low > high[2]
        fvgSize = low - high[2]
        bosOk   = not requireBOS or close > bFcHi
        if bImp >= minImpulse and fvgOk and fvgSize >= minFvgAtr * atr and bosOk
            bFvgTop  := low
            bFvgBot  := high[2]
            bTrig    := fvgFillMode == "Borde (primer toque)" ? low : fvgFillMode == "Relleno total" ? high[2] : (low + high[2]) / 2
            bImpSave := bImp
            bFvgQual := minFvgAtr > 0 ? fvgSize / (minFvgAtr * atr) : 2.0
            bSt      := 3
            bStBar   := bar_index
            markM_L  := true
            if showZonesB
                bFvgBox := box.new(bar_index - 2, bFvgTop, bar_index + 1, bFvgBot, border_color=color.new(colBull, 30), bgcolor=color.new(colBull, 80), text="hueco · esperar regreso", text_color=color.new(colBull, 20), text_size=size.tiny, text_halign=text.align_right)
        else if bar_index - bStBar > maxWaitExp
            bSt := 0

else if bSt == 3
    if not na(bFvgBox)
        box.set_right(bFvgBox, bar_index + 1)
    touched   = low <= bTrig
    confirmOk = entryMode == "Toque" ? touched : touched and bullBar and close > bTrig
    if close < bStruct - tol
        bSt := 0
    else if confirmOk and allowLong and coolOk and flat
        buyRdy := true
        bSt    := 0
    else if bar_index - bStBar > maxWaitRetest
        bSt := 0

// ————— máquina bajista —————
if sSt == 0
    freshPH = not na(lastPH) and not phUsed and bar_index - lastPHBar <= sweepMaxAge
    if freshPH and high > lastPH and close < lastPH and allowShort
        sSt     := 1
        sFcHi   := high
        sFcLo   := math.min(open, close)
        sStruct := high
        sStBar  := bar_index
        sImp    := 0
        sAway   := false
        phUsed  := true
        markL_S := true

else if sSt == 1
    if high > sFcHi + tol
        sSt := 0
    else
        if high > sFcHi
            sStruct := high
        if low < sFcLo - awayAtr * atr
            sAway := true
        if sAway and high >= sFcLo
            sSt     := 2
            sStBar  := bar_index
            sImp    := 0
            markF_S := true
        else if bar_index - sStBar > maxWaitMitig
            sSt := 0

else if sSt == 2
    if high > sStruct + tol
        sSt := 0
    else
        sImp := bearBar and bodySz >= dispMult * atr ? sImp + 1 : 0
        fvgOkS   = high < low[2]
        fvgSizeS = low[2] - high
        bosOkS   = not requireBOS or close < sFcLo
        if sImp >= minImpulse and fvgOkS and fvgSizeS >= minFvgAtr * atr and bosOkS
            sFvgBot  := high
            sFvgTop  := low[2]
            sTrig    := fvgFillMode == "Borde (primer toque)" ? high : fvgFillMode == "Relleno total" ? low[2] : (high + low[2]) / 2
            sImpSave := sImp
            sFvgQual := minFvgAtr > 0 ? fvgSizeS / (minFvgAtr * atr) : 2.0
            sSt      := 3
            sStBar   := bar_index
            markM_S  := true
            if showZonesB
                sFvgBox := box.new(bar_index - 2, sFvgTop, bar_index + 1, sFvgBot, border_color=color.new(colBear, 30), bgcolor=color.new(colBear, 80), text="hueco · esperar regreso", text_color=color.new(colBear, 20), text_size=size.tiny, text_halign=text.align_right)
        else if bar_index - sStBar > maxWaitExp
            sSt := 0

else if sSt == 3
    if not na(sFvgBox)
        box.set_right(sFvgBox, bar_index + 1)
    touchedS   = high >= sTrig
    confirmOkS = entryMode == "Toque" ? touchedS : touchedS and bearBar and close < sTrig
    if close > sStruct + tol
        sSt := 0
    else if confirmOkS and allowShort and coolOk and flat
        sellRdy := true
        sSt     := 0
    else if bar_index - sStBar > maxWaitRetest
        sSt := 0

// =====================================================================================
// ACUMULACIÓN
// =====================================================================================
dualFF = inAccum and bSt >= 2 and sSt >= 2
if accOnlyDom and dualFF
    if buyRdy and not biasBull
        buyRdy := false
    if sellRdy and not biasBear
        sellRdy := false

// fondo suave cuando el precio está encerrado en acumulación
bgcolor(accShade and inAccum ? color.new(color.orange, 92) : na)

// =====================================================================================
// PUNTAJE, CHECKLIST Y PROBABILIDAD
// =====================================================================================
var array<float> prevLong  = array.new<float>()
var array<float> prevShort = array.new<float>()

// historial por nota: 3 = A+, 2 = A, 1 = B (y C si se baja el mínimo)
var int gW3 = 0
var int gT3 = 0
var int gW2 = 0
var int gT2 = 0
var int gW1 = 0
var int gT1 = 0

isRepeated(array<float> arr, float lvl) =>
    rep = false
    tolr = lvl * repTolPct / 100
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            if math.abs(lvl - array.get(arr, i)) <= tolr
                rep := true
    rep

gradeOf(int sc) => sc >= 80 ? "A+" : sc >= 65 ? "A" : sc >= 50 ? "B" : "C"

// P%: winrate real de la nota si ya hay muestra suficiente; si no, estimación por puntaje
probFor(int sc) =>
    g  = gradeOf(sc)
    bt = g == "A+" ? gT3 : g == "A" ? gT2 : gT1
    bw = g == "A+" ? gW3 : g == "A" ? gW2 : gW1
    bt >= minProbN ? 100.0 * bw / bt : 35.0 + sc * 0.32

calcScore(bool isLong, int impSave, float fvgQual) =>
    c1 = isLong ? biasBull : biasBear
    c2 = isLong ? inBullZone : inBearZone
    c3 = dualFF and (isLong ? biasBull : biasBear)
    c4 = inKill
    c5 = volHigh
    c6 = impSave >= 3
    c7 = fvgQual >= 1.5
    c8 = isRepeated(isLong ? prevLong : prevShort, close)
    sc = (c1 ? wMtf : 0) + (c2 ? wZone : 0) + (c3 ? wAcum : 0) + (c4 ? wSess : 0) + (c5 ? wVol : 0) + (c6 ? wImp : 0) + (c7 ? wFvg : 0) + (c8 ? wRep : 0)
    chk = "MTF" + (c1 ? "✓" : "✗") + " FC" + (c2 ? "✓" : "✗") + " ACU" + (c3 ? "✓" : "✗") + " KZ" + (c4 ? "✓" : "✗") + "\nVOL" + (c5 ? "✓" : "✗") + " IMP" + (c6 ? "✓" : "✗") + " FVG" + (c7 ? "✓" : "✗") + " REP" + (c8 ? "✓" : "✗")
    [sc, chk]

bool buySig  = false
bool sellSig = false
var int    sigScore = 0
var string sigGrade = "—"
var float  sigProb  = 0.0
var string sigChk   = ""

if buyRdy
    [scL, chkL] = calcScore(true, bImpSave, bFvgQual)
    if scL >= minScore
        buySig   := true
        sigScore := scL
        sigGrade := gradeOf(scL)
        sigProb  := probFor(scL)
        sigChk   := chkL
        array.push(prevLong, close)
        if array.size(prevLong) > 10
            array.shift(prevLong)

if sellRdy
    [scS, chkS] = calcScore(false, sImpSave, sFvgQual)
    if scS >= minScore
        sellSig  := true
        sigScore := scS
        sigGrade := gradeOf(scS)
        sigProb  := probFor(scS)
        sigChk   := chkS
        array.push(prevShort, close)
        if array.size(prevShort) > 10
            array.shift(prevShort)

// =====================================================================================
// GESTOR DE OPERACIÓN VIRTUAL + HISTORIAL
// =====================================================================================
var int   nTrades  = 0
var int   nWins    = 0
var int   nLoss    = 0
var float netR     = 0.0
var int   streak   = 0
var string lastRes = "—"

closeTrade(bool won, float rGain, string tag) =>
    if not na(tRisk)
        box.set_right(tRisk, bar_index)
        if not keepHistory
            box.delete(tRisk)
    if not na(tRew)
        box.set_right(tRew, bar_index)
        if not keepHistory
            box.delete(tRew)
    resTxt = (won ? "✔ " : "✘ ") + tag + " " + (rGain >= 0 ? "+" : "") + str.tostring(rGain, "#.#") + "R (" + gradeOf(tScore) + ")"
    label.new(bar_index, won ? high : low, resTxt, style = won ? label.style_label_down : label.style_label_up, color = won ? color.new(#0F7A4D, 10) : color.new(#C4243C, 10), textcolor=color.white, size=size.small)
    resTxt

// --- apertura LONG ---
if buySig
    tDir   := 1
    tEntry := entryMode == "Toque" ? bTrig : close
    tSl    := bStruct - slBuffAtr * atr
    riskL  = math.max(tEntry - tSl, syminfo.mintick)
    tTp    := tEntry + rr1 * riskL
    tBar   := bar_index
    tScore := sigScore
    tRisk  := box.new(bar_index, tEntry, bar_index + 1, tSl, border_color=color.new(#C4243C, 55), bgcolor=color.new(#C4243C, 85))
    tRew   := box.new(bar_index, tTp, bar_index + 1, tEntry, border_color=color.new(#0F7A4D, 55), bgcolor=color.new(#0F7A4D, 85))
    lastSigBar := bar_index
    // chequeo de camino libre: ¿hay FC bajista vivo entre entrada y TP?
    obstL = false
    if array.size(zsLvl) > 0
        for i = 0 to array.size(zsLvl) - 1
            lvlO = array.get(zsLvl, i)
            if lvlO > tEntry and lvlO < tTp
                obstL := true
    lotL = riskL > 0 and usdPerPt > 0 ? (capUSD * riskPctIn / 100) / (riskL * usdPerPt) : 0.0
    txtL = "▲ BUY · P≈" + str.tostring(sigProb, "#") + "% · " + str.tostring(sigScore) + " " + sigGrade
    txtL := txtL + "\nE " + str.tostring(tEntry, format.mintick) + " · SL " + str.tostring(tSl, format.mintick)
    txtL := txtL + "\nTP " + str.tostring(tTp, format.mintick) + " · R:R 1:" + str.tostring(rr1, "#.#")
    txtL := txtL + "\nLote≈" + str.tostring(lotL, "#.##") + " (riesgo " + str.tostring(riskPctIn, "#.##") + "%)"
    if showCheck
        txtL := txtL + "\n" + sigChk
    if obstL
        txtL := txtL + "\n⚠ FC opuesto antes del TP"
    label.new(bar_index, low, txtL, style=label.style_label_up, color=colBull, textcolor=color.white, size=size.normal)

// --- apertura SHORT ---
if sellSig
    tDir   := -1
    tEntry := entryMode == "Toque" ? sTrig : close
    tSl    := sStruct + slBuffAtr * atr
    riskS  = math.max(tSl - tEntry, syminfo.mintick)
    tTp    := tEntry - rr1 * riskS
    tBar   := bar_index
    tScore := sigScore
    tRisk  := box.new(bar_index, tSl, bar_index + 1, tEntry, border_color=color.new(#C4243C, 55), bgcolor=color.new(#C4243C, 85))
    tRew   := box.new(bar_index, tEntry, bar_index + 1, tTp, border_color=color.new(#0F7A4D, 55), bgcolor=color.new(#0F7A4D, 85))
    lastSigBar := bar_index
    obstS = false
    if array.size(zbLvl) > 0
        for i = 0 to array.size(zbLvl) - 1
            lvlO2 = array.get(zbLvl, i)
            if lvlO2 < tEntry and lvlO2 > tTp
                obstS := true
    lotS = riskS > 0 and usdPerPt > 0 ? (capUSD * riskPctIn / 100) / (riskS * usdPerPt) : 0.0
    txtS = "▼ SELL · P≈" + str.tostring(sigProb, "#") + "% · " + str.tostring(sigScore) + " " + sigGrade
    txtS := txtS + "\nE " + str.tostring(tEntry, format.mintick) + " · SL " + str.tostring(tSl, format.mintick)
    txtS := txtS + "\nTP " + str.tostring(tTp, format.mintick) + " · R:R 1:" + str.tostring(rr1, "#.#")
    txtS := txtS + "\nLote≈" + str.tostring(lotS, "#.##") + " (riesgo " + str.tostring(riskPctIn, "#.##") + "%)"
    if showCheck
        txtS := txtS + "\n" + sigChk
    if obstS
        txtS := txtS + "\n⚠ FC opuesto antes del TP"
    label.new(bar_index, high, txtS, style=label.style_label_down, color=colBear, textcolor=color.white, size=size.normal)

// --- seguimiento y cierre (en velas posteriores a la apertura) ---
bool winEvt  = false
bool lossEvt = false

if tDir != 0 and bar_index > tBar
    if not na(tRisk)
        box.set_right(tRisk, bar_index + 1)
    if not na(tRew)
        box.set_right(tRew, bar_index + 1)

    hitSl = tDir == 1 ? low <= tSl : high >= tSl
    hitTp = tDir == 1 ? high >= tTp : low <= tTp

    if hitSl
        // regla conservadora: si tocó ambos en la misma vela, cuenta SL
        nTrades += 1
        nLoss   += 1
        netR    -= 1.0
        streak  := streak < 0 ? streak - 1 : -1
        lastRes := closeTrade(false, -1.0, "SL")
        lossEvt := true
        tDir    := 0
    else if hitTp
        nTrades += 1
        nWins   += 1
        netR    += rr1
        streak  := streak > 0 ? streak + 1 : 1
        lastRes := closeTrade(true, rr1, "TP")
        winEvt  := true
        tDir    := 0
    else if bar_index - tBar >= maxTradeBars
        riskAbs = math.abs(tEntry - tSl)
        rNow    = riskAbs > 0 ? (tDir == 1 ? close - tEntry : tEntry - close) / riskAbs : 0.0
        won     = rNow >= 0
        nTrades += 1
        if won
            nWins += 1
            streak := streak > 0 ? streak + 1 : 1
        else
            nLoss += 1
            streak := streak < 0 ? streak - 1 : -1
        netR    += rNow
        lastRes := closeTrade(won, rNow, "TIEMPO")
        if won
            winEvt := true
        else
            lossEvt := true
        tDir := 0

// actualizar el historial por nota (tScore aún guarda la operación cerrada)
if winEvt or lossEvt
    gCl = gradeOf(tScore)
    if gCl == "A+"
        gT3 += 1
        gW3 += winEvt ? 1 : 0
    else if gCl == "A"
        gT2 += 1
        gW2 += winEvt ? 1 : 0
    else
        gT1 += 1
        gW1 += winEvt ? 1 : 0

winrate = nTrades > 0 ? 100.0 * nWins / nTrades : 0.0

// =====================================================================================
// VISUALES DE FASES + AVISO PREPARAR
// =====================================================================================
txL1 = easyLabels ? "1·Barrido"   : "L"
txF1 = easyLabels ? "2·Mitigado"  : "F"
txM1 = easyLabels ? "3·Hueco listo" : "M"

if showPhases and markL_L
    label.new(bar_index, low,  txL1, style=label.style_label_up,   color=color.new(color.yellow, 25), textcolor=color.black, size=size.tiny, tooltip="Paso 1: el precio barrió el mínimo y lo rechazó. Empieza el patrón de COMPRA.")
if showPhases and markL_S
    label.new(bar_index, high, txL1, style=label.style_label_down, color=color.new(color.yellow, 25), textcolor=color.black, size=size.tiny, tooltip="Paso 1: el precio barrió el máximo y lo rechazó. Empieza el patrón de VENTA.")
if showPhases and markF_L
    label.new(bar_index, low,  txF1, style=label.style_label_up,   color=color.new(color.orange, 25), textcolor=color.white, size=size.tiny, tooltip="Paso 2: el precio regresó a la zona y limpió a los impacientes. El patrón sigue vivo.")
if showPhases and markF_S
    label.new(bar_index, high, txF1, style=label.style_label_down, color=color.new(color.orange, 25), textcolor=color.white, size=size.tiny, tooltip="Paso 2: el precio regresó a la zona y limpió a los impacientes. El patrón sigue vivo.")
if showPhases and markM_L
    label.new(bar_index, high, txM1, style=label.style_label_down, color=color.new(colBull, 20), textcolor=color.white, size=size.tiny, tooltip="Paso 3: impulso fuerte que dejó un hueco sin operar. Ahora se espera el regreso al hueco.")
if showPhases and markM_S
    label.new(bar_index, low,  txM1, style=label.style_label_up,   color=color.new(colBear, 20), textcolor=color.white, size=size.tiny, tooltip="Paso 3: impulso fuerte que dejó un hueco sin operar. Ahora se espera el regreso al hueco.")

// PREPARAR: la ineficiencia acaba de crearse → plan de la operación antes de la señal
if showPrep and markM_L
    pSlL = bStruct - slBuffAtr * atr
    pRkL = math.max(bTrig - pSlL, syminfo.mintick)
    label.new(bar_index, low, "PREPARAR COMPRA\nE≈" + str.tostring(bTrig, format.mintick) + "\nSL " + str.tostring(pSlL, format.mintick) + "\nTP " + str.tostring(bTrig + rr1 * pRkL, format.mintick), style=label.style_label_upper_right, color=color.new(colBull, 60), textcolor=color.white, size=size.tiny)
if showPrep and markM_S
    pSlS = sStruct + slBuffAtr * atr
    pRkS = math.max(pSlS - sTrig, syminfo.mintick)
    label.new(bar_index, high, "PREPARAR VENTA\nE≈" + str.tostring(sTrig, format.mintick) + "\nSL " + str.tostring(pSlS, format.mintick) + "\nTP " + str.tostring(sTrig - rr1 * pRkS, format.mintick), style=label.style_label_lower_right, color=color.new(colBear, 60), textcolor=color.white, size=size.tiny)

barcolor(buySig ? colBull : sellSig ? colBear : na)

// =====================================================================================
// GUÍA ¿QUÉ PASA AHORA? — español simple para decidir sin conocer el sistema
// =====================================================================================
stepDesc(int st) =>
    st == 0 ? "Paso 1/4 · buscando barrido de liquidez" :
     st == 1 ? "Paso 2/4 · barrido hecho, falta el regreso a la zona" :
     st == 2 ? "Paso 3/4 · zona mitigada, falta impulso con hueco" :
     "Paso 4/4 · ¡hueco listo! esperando regreso para ENTRAR"

// qué hace el precio, en palabras
ctxTxt = tDir != 0 ? "OPERACIÓN EN CURSO" :
     dualFF ? "ACUMULACIÓN · trampa armada en ambos extremos" :
     inAccum ? "ACUMULACIÓN · el precio está encerrado en un rango" :
     not volOk ? "MERCADO DORMIDO · muy poca volatilidad" :
     biasBull ? "TENDENCIA ALCISTA · solo interesan compras" :
     biasBear ? "TENDENCIA BAJISTA · solo interesan ventas" :
     "SIN DIRECCIÓN CLARA · mejor esperar"
ctxCol = tDir != 0 ? color.new(#FFD54F, 0) : dualFF or inAccum ? color.orange : not volOk ? color.new(#666666, 0) : biasBull ? color.new(#37D28B, 0) : biasBear ? color.new(#FF5C72, 0) : color.new(#999999, 0)

// la instrucción del momento
actTxt = tDir == 1 ? "COMPRA ACTIVA · no toques nada: se cierra sola en TP o SL" :
     tDir == -1 ? "VENTA ACTIVA · no toques nada: se cierra sola en TP o SL" :
     bSt == 3 and sSt == 3 ? "MÁXIMA ATENCIÓN · puede salir señal en cualquier dirección" :
     bSt == 3 ? "ATENTO · posible COMPRA cuando el precio regrese al hueco azul" :
     sSt == 3 ? "ATENTO · posible VENTA cuando el precio regrese al hueco rosado" :
     bSt == 2 or sSt == 2 ? "PREPÁRATE · falta el impulso fuerte que deje el hueco" :
     bSt == 1 or sSt == 1 ? "PACIENCIA · el patrón apenas está comenzando" :
     "ESPERA · no hay patrón en formación. No operes por aburrimiento"
actCol = tDir != 0 ? color.new(#FFD54F, 0) : bSt == 3 or sSt == 3 ? color.new(#37D28B, 0) : bSt >= 1 or sSt >= 1 ? color.orange : color.new(#999999, 0)

gPos = guidePos == "Superior derecha" ? position.top_right : guidePos == "Superior izquierda" ? position.top_left : guidePos == "Inferior derecha" ? position.bottom_right : position.bottom_left
var table guide = table.new(gPos, 2, 5, border_width=1, frame_width=2, frame_color=color.new(#C9A227, 30))

if showGuide and barstate.islast
    gDark  = color.new(#0B0B0B, 5)
    gDark2 = color.new(#151515, 5)
    gTxt   = color.new(#D0D0D0, 0)

    table.clear(guide, 0, 0, 1, 4)
    table.cell(guide, 0, 0, "GUÍA · ¿QUÉ PASA AHORA?", text_color=color.black, bgcolor=color.new(#C9A227, 0), text_size=size.normal)
    table.merge_cells(guide, 0, 0, 1, 0)

    table.cell(guide, 0, 1, "El precio está en:", text_color=gTxt, bgcolor=gDark, text_size=size.small)
    table.cell(guide, 1, 1, ctxTxt, text_color=ctxCol, bgcolor=gDark, text_size=size.small)

    table.cell(guide, 0, 2, "Patrón de COMPRA:", text_color=gTxt, bgcolor=gDark2, text_size=size.small)
    table.cell(guide, 1, 2, stepDesc(bSt), text_color = bSt > 0 ? color.new(#37D28B, 0) : color.new(#777777, 0), bgcolor=gDark2, text_size=size.small)

    table.cell(guide, 0, 3, "Patrón de VENTA:", text_color=gTxt, bgcolor=gDark, text_size=size.small)
    table.cell(guide, 1, 3, stepDesc(sSt), text_color = sSt > 0 ? color.new(#FF5C72, 0) : color.new(#777777, 0), bgcolor=gDark, text_size=size.small)

    table.cell(guide, 0, 4, "AHORA:", text_color=color.black, bgcolor=color.new(#C9A227, 25), text_size=size.small)
    table.cell(guide, 1, 4, actTxt, text_color=actCol, bgcolor=gDark2, text_size=size.small)

// =====================================================================================
// PANEL CON ESTADÍSTICAS
// =====================================================================================
stName(st) => st == 0 ? "—" : st == 1 ? "FC" : st == 2 ? "MITIGADO" : "TESTEO"
grTxt(int w, int t) => t > 0 ? str.tostring(w) + "/" + str.tostring(t) + " (" + str.tostring(100.0 * w / t, "#") + "%)" : "—"
pPos = panelPos == "Superior derecha" ? position.top_right : panelPos == "Superior izquierda" ? position.top_left : panelPos == "Inferior derecha" ? position.bottom_right : position.bottom_left
pTxt = panelSize == "Normal" ? size.small : size.normal
pHdr = panelSize == "Normal" ? size.normal : size.large

var table panel = table.new(pPos, 4, 11, border_width=1, frame_width=2, frame_color=color.new(#C9A227, 30))

if showPanel and barstate.islast
    cDark  = color.new(#0B0B0B, 5)
    cDark2 = color.new(#151515, 5)
    cTxt   = color.new(#D0D0D0, 0)
    cOn    = #FFD54F
    cOff   = color.new(#666666, 0)
    cUp    = #37D28B
    cDn    = #FF5C72

    table.clear(panel, 0, 0, 3, 10)

    table.cell(panel, 0, 0, "FENIX FF SIGNALS", text_color=color.black, bgcolor=colHeader, text_size=pHdr)
    table.merge_cells(panel, 0, 0, 2, 0)
    table.cell(panel, 3, 0, "◆", text_color=color.black, bgcolor=colHeader, text_size=pHdr)

    table.cell(panel, 0, 1, "Operación:", text_color=cTxt, bgcolor=cDark, text_size=pTxt)
    table.cell(panel, 1, 1, tDir == 1 ? "▲ LONG" : tDir == -1 ? "▼ SHORT" : "SIN TRADE", text_color = tDir == 1 ? cUp : tDir == -1 ? cDn : cOff, bgcolor=cDark, text_size=pTxt)
    table.cell(panel, 2, 1, tDir != 0 ? "E " + str.tostring(tEntry, format.mintick) : "—", text_color=color.white, bgcolor=cDark, text_size=pTxt)
    table.cell(panel, 3, 1, tDir != 0 ? str.tostring(tScore) + " " + gradeOf(tScore) : "—", text_color=cOn, bgcolor=cDark, text_size=pTxt)

    table.cell(panel, 0, 2, "Niveles:", text_color=cTxt, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 1, 2, tDir != 0 ? "SL " + str.tostring(tSl, format.mintick) : "—", text_color=cDn, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 2, 2, tDir != 0 ? "TP " + str.tostring(tTp, format.mintick) : "—", text_color=cUp, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 3, 2, tDir != 0 ? str.tostring(bar_index - tBar) + " v" : "—", text_color=cTxt, bgcolor=cDark2, text_size=pTxt)

    table.cell(panel, 0, 3, "Historial:", text_color=cTxt, bgcolor=cDark, text_size=pTxt)
    table.cell(panel, 1, 3, "✔ " + str.tostring(nWins), text_color=cUp, bgcolor=cDark, text_size=pTxt)
    table.cell(panel, 2, 3, "✘ " + str.tostring(nLoss), text_color=cDn, bgcolor=cDark, text_size=pTxt)
    table.cell(panel, 3, 3, str.tostring(nTrades), text_color=cTxt, bgcolor=cDark, text_size=pTxt)

    table.cell(panel, 0, 4, "Winrate:", text_color=cTxt, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 1, 4, str.tostring(winrate, "#.#") + "%", text_color = winrate >= 50 ? cUp : cDn, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 2, 4, "R neto:", text_color=cTxt, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 3, 4, (netR >= 0 ? "+" : "") + str.tostring(netR, "#.#") + "R", text_color = netR >= 0 ? cUp : cDn, bgcolor=cDark2, text_size=pTxt)

    table.cell(panel, 0, 5, "Por nota:", text_color=cTxt, bgcolor=cDark, text_size=pTxt)
    table.cell(panel, 1, 5, "A+ " + grTxt(gW3, gT3), text_color=cUp, bgcolor=cDark, text_size=size.tiny)
    table.cell(panel, 2, 5, "A " + grTxt(gW2, gT2), text_color=cOn, bgcolor=cDark, text_size=size.tiny)
    table.cell(panel, 3, 5, "B " + grTxt(gW1, gT1), text_color=cTxt, bgcolor=cDark, text_size=size.tiny)

    table.cell(panel, 0, 6, "Racha / Último:", text_color=cTxt, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 1, 6, (streak > 0 ? "+" : "") + str.tostring(streak), text_color = streak >= 0 ? cUp : cDn, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 2, 6, lastRes, text_color=cTxt, bgcolor=cDark2, text_size=size.tiny)
    table.merge_cells(panel, 2, 6, 3, 6)

    table.cell(panel, 0, 7, "Sesgo MTF " + htfTf + ":", text_color=cTxt, bgcolor=cDark, text_size=pTxt)
    table.cell(panel, 1, 7, biasBull ? "▲ UP" : biasBear ? "▼ DOWN" : "FLAT", text_color = biasBull ? cUp : biasBear ? cDn : cOff, bgcolor=cDark, text_size=pTxt)
    table.cell(panel, 2, 7, "Killzone:", text_color=cTxt, bgcolor=cDark, text_size=pTxt)
    table.cell(panel, 3, 7, inKill ? "SÍ" : "NO", text_color = inKill ? cOn : cOff, bgcolor=cDark, text_size=pTxt)

    table.cell(panel, 0, 8, "Zonas FC:", text_color=cTxt, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 1, 8, "▲ " + str.tostring(array.size(zbLvl)), text_color=colFCBull, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 2, 8, "▼ " + str.tostring(array.size(zsLvl)), text_color=colFCBear, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 3, 8, "Vol " + (volHigh ? "▲" : "▼"), text_color = volHigh ? cUp : cOff, bgcolor=cDark2, text_size=pTxt)

    table.cell(panel, 0, 9, "Setup F+F:", text_color=cTxt, bgcolor=cDark, text_size=pTxt)
    table.cell(panel, 1, 9, "▲ " + stName(bSt), text_color = bSt > 0 ? cUp : cOff, bgcolor=cDark, text_size=pTxt)
    table.cell(panel, 2, 9, "▼ " + stName(sSt), text_color = sSt > 0 ? cDn : cOff, bgcolor=cDark, text_size=pTxt)
    table.cell(panel, 3, 9, dualFF ? "ACUM" : inAccum ? "RANGO" : "EXPAN", text_color = dualFF ? color.orange : cTxt, bgcolor=cDark, text_size=pTxt)

    table.cell(panel, 0, 10, "TF " + timeframe.period + (autoTf ? " · AUTO" : " · MAN"), text_color=cTxt, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 1, 10, "Min: " + str.tostring(minScore), text_color=cTxt, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 2, 10, "ATR " + str.tostring(atrPct, "#.##") + "%", text_color = volOk ? color.teal : cOff, bgcolor=cDark2, text_size=pTxt)
    table.cell(panel, 3, 10, sessionOk ? "OK" : "FUERA", text_color = sessionOk ? cOn : cOff, bgcolor=cDark2, text_size=size.tiny)

// =====================================================================================
// ALERTAS
// =====================================================================================
if buySig
    alert("FENIX ▲ COMPRA " + syminfo.ticker + " " + timeframe.period + " | P≈" + str.tostring(sigProb, "#") + "% (" + str.tostring(sigScore) + " " + sigGrade + ") | E " + str.tostring(tEntry, format.mintick) + " | SL " + str.tostring(tSl, format.mintick) + " | TP " + str.tostring(tTp, format.mintick), alert.freq_once_per_bar_close)
if sellSig
    alert("FENIX ▼ VENTA " + syminfo.ticker + " " + timeframe.period + " | P≈" + str.tostring(sigProb, "#") + "% (" + str.tostring(sigScore) + " " + sigGrade + ") | E " + str.tostring(tEntry, format.mintick) + " | SL " + str.tostring(tSl, format.mintick) + " | TP " + str.tostring(tTp, format.mintick), alert.freq_once_per_bar_close)
if winEvt
    alert("FENIX ✔ TP alcanzado en " + syminfo.ticker + " " + timeframe.period + " | " + lastRes + " | Winrate " + str.tostring(winrate, "#.#") + "% | R neto " + str.tostring(netR, "#.#"), alert.freq_once_per_bar_close)
if lossEvt
    alert("FENIX ✘ SL tocado en " + syminfo.ticker + " " + timeframe.period + " | " + lastRes + " | Winrate " + str.tostring(winrate, "#.#") + "% | R neto " + str.tostring(netR, "#.#"), alert.freq_once_per_bar_close)
if markM_L
    alert("FENIX · PREPARAR COMPRA en " + syminfo.ticker + " " + timeframe.period + " | E≈" + str.tostring(bTrig, format.mintick) + " — esperar el regreso al hueco", alert.freq_once_per_bar_close)
if markM_S
    alert("FENIX · PREPARAR VENTA en " + syminfo.ticker + " " + timeframe.period + " | E≈" + str.tostring(sTrig, format.mintick) + " — esperar el regreso al hueco", alert.freq_once_per_bar_close)

alertcondition(buySig,  title="SIGNALS — COMPRA",     message="FENIX COMPRA {{ticker}} {{interval}} @ {{close}}")
alertcondition(sellSig, title="SIGNALS — VENTA",      message="FENIX VENTA {{ticker}} {{interval}} @ {{close}}")
alertcondition(winEvt,  title="SIGNALS — TP tocado",  message="FENIX TP alcanzado {{ticker}} {{interval}}")
alertcondition(lossEvt, title="SIGNALS — SL tocado",  message="FENIX SL tocado {{ticker}} {{interval}}")
alertcondition(markM_L or markM_S, title="SIGNALS — Preparar entrada", message="FENIX hueco creado {{ticker}} {{interval}}")

plot(buySig ? 1 : sellSig ? -1 : 0, "Señal", display=display.data_window)
plot(sigScore, "Puntaje",      display=display.data_window)
plot(sigProb,  "Probabilidad", display=display.data_window)
plot(netR,     "R neto",       display=display.data_window)
