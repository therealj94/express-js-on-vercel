# EL MODELO Y LA VENTANA, EN UN SOLO SITIO.
#
# Esto existe por una leccion que costo caro dos veces. Antes el nombre del
# modelo y el tamano de la ventana estaban escritos a mano en SIETE lugares:
#
#   /etc/ultron-motor.env            ULTRON_MOTOR_MODELO / _CTX
#   aura.service.d/*.conf            AURA_MODELO / _PENSADOR / _VENTANA
#   /usr/local/bin/ogb-tibio.sh      el pulso de cada tres minutos
#   /usr/local/bin/ollama-vigia.sh   el reclavado despues de reiniciar
#   /usr/local/bin/ogb-precalentar.sh  el de arranque
#
# Y ollama carga el modelo con la ventana del PRIMERO que la pide. O sea que
# si uno solo se queda atras, cada pedido suyo RECARGA 16 GB de disco y la
# junta espera dos minutos sin que nada parezca roto. Paso con la ventana el
# 7-sep: ogb-precalentar.sh se quedo en 32 768 mientras los demas ya iban en
# 24 576, y no habia forma de verlo salvo leyendo los cinco archivos.
#
# Ahora se escribe UNA vez, aqui, y todos lo leen. Cambiar de modelo o de
# ventana es cambiar este archivo y reiniciar. Nadie mas escribe estos
# numeros a mano.
#
# Los nombres estan repetidos a proposito: cada servicio ya buscaba el suyo, y
# renombrarlos habria sido otro cambio en siete sitios para ahorrar tres
# lineas.

# El modelo que atiende a la junta (ULTRON) y a la gente (AU-RA).
OGB_MODELO=orcarouter/Qwen3.8-27B-Uncensored
ULTRON_MOTOR_MODELO=orcarouter/Qwen3.8-27B-Uncensored
AURA_MODELO=orcarouter/Qwen3.8-27B-Uncensored
AURA_MODELO_PENSADOR=orcarouter/Qwen3.8-27B-Uncensored

# La ventana. La eligio el trafico real: siete dias de registro con un pico de
# 21 868 fichas en los turnos largos de herramientas, asi que 24 576 lo cubre
# con aire. Subirla no hace a nadie mas listo; solo ocupa tarjeta.
OGB_CTX=24576
ULTRON_MOTOR_CTX=24576
AURA_VENTANA=24576

# El de vectores, que es chico y va siempre al lado.
OGB_MODELO_VECTOR=embeddinggemma:300m
ULTRON_MOTOR_VECTOR=embeddinggemma:300m
