# Secreto para firmar los tokens de sesión (JWT). Usa un valor largo y aleatorio en producción.
JWT_SECRET=change-me-in-production

# Puerto local del servidor Express (opcional, por defecto 3001)
PORT=3001

# Administrador del panel. ADMIN_PASSWORD es SU contraseña también si la cuenta ya
# existe: cambiarla y reiniciar la rota y cierra sus sesiones (ver ENTREGA.md).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# «Olvidé mi contraseña»: sin envío de correo, el código de reseteo va en la
# respuesta para que la app lo complete (nunca para el administrador). Con «si»
# no se entrega a nadie y el reseteo deja de funcionar hasta que haya correo.
# MTP_OCULTAR_TOKEN_RESETEO=si
