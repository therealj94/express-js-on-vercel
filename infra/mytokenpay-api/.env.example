# Secreto para firmar los tokens de sesión (JWT). Usa un valor largo y aleatorio en producción.
JWT_SECRET=change-me-in-production

# Puerto local del servidor Express (opcional, por defecto 3001)
PORT=3001

# Atar cuentas de MyTokenPay a Genesis ID (/genesis/vincular y el vínculo de
# /api/auth/sso). APAGADO por omisión: "1" lo enciende. No lo enciendas hasta que
# MyTokenPay verifique correos y pueda revocar sesiones (ver src/lib/genesis.ts).
# MTP_VINCULO_GENESIS=1
