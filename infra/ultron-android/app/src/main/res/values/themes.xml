<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- OJO CON EL PADRE. La actividad es una AppCompatActivity —hace falta
         para el diálogo de la actualización y para el gesto de atrás—, y
         AppCompat EXIGE un tema suyo: con `android:Theme.Material` la app se
         cierra al abrir con «You need to use a Theme.AppCompat theme». No es
         un aviso, es un cierre en el primer segundo.
         Y el negro del tablero: sin esto, al abrir se ve un destello blanco
         antes de que cargue la página, que es lo que hace que una app envuelta
         parezca una web envuelta. -->
    <style name="TemaUltron" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
