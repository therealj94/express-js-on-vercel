 // ============================================================
 // Precio de ORIGEN en USD.
 //
-//   ORIGEN = (precio de la onza de oro / 31.1035) / 55
+// DECIDIDO EL 12-AGO-2026: PRECIO FIJO DE 0,01 USD PARA LA 5550.
