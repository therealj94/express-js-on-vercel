{
  "expo": {
    "name": "MyTokenPay",
    "slug": "mytokenpay",
    "scheme": "mytokenpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0812",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0812"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mytokenpay.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MyTokenPay usa la cámara para leer el código de cobro del comercio.",
        "NSFaceIDUsageDescription": "MyTokenPay usa Face ID para desbloquear tu cuenta.",
        "NSPhotoLibraryUsageDescription": "MyTokenPay accede a tus fotos para subir los documentos de verificación de tu negocio.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.mytokenpay.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0A0812"
      },
      "predictiveBackGestureEnabled": false,
      "minSdkVersion": 21,
      "targetSdkVersion": 34,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MyTokenPay usa tu ubicación para marcar el pin exacto de tu negocio en el mapa."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MyTokenPay necesita acceso a tus fotos para subir el logo, la portada y tus documentos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MyTokenPay usa la cámara para leer el código de cobro del comercio."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MyTokenPay usa Face ID para desbloquear tu cuenta."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "newArchEnabled": true,
    "owner": "vetawallet",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc7468d1-e7a1-4bf2-9c2a-9d03ddab6fe9"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/bc7468d1-e7a1-4bf2-9c2a-9d03ddab6fe9",
      "fallbackToCacheTimeout": 0
    }
  }
}