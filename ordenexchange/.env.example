# ─── OrdenExchange · variables de entorno ────────────────────────────────────
# Copie este archivo a .env para desarrollo. En Render las fija el blueprint
# (render.yaml, servicio «ordenexchange»); en Vercel, el panel del proyecto.

# Puerto local (por defecto 4100)
PORT=4100

# Sesiones de usuario. OBLIGATORIO en producción: sin él el servidor no arranca.
ORDENEX_JWT_SECRETO=cambie-esto-por-un-secreto-largo-y-al-azar

# Almacén. Sin ORDENEX_MONGO_URL los datos van a un JSON (./data/ordenexchange.json),
# que sirve para desarrollo y demostraciones pero NO para custodiar saldos reales.
# ORDENEX_MONGO_URL=mongodb+srv://usuario:clave@cluster/ordenexchange
# ORDENEX_MONGO_DB=ordenexchange
# ORDENEX_DATA_FILE=./data/ordenexchange.json

# Primer administrador del panel (/admin). Si no se fija la contraseña, se
# genera una y se imprime UNA sola vez al arrancar.
ORDENEX_ADMIN_EMAIL=admin@ordenglobal.link
# ORDENEX_ADMIN_PASSWORD=

# Genesis ID: la clave de la app «ordenexchange». Vive SOLO aquí, nunca en el
# navegador. Sin ella nadie puede verificar su identidad ni operar (salvo demo).
GENESIS_URL=https://genesis-id.onrender.com
# GENESIS_API_KEY=gid_live_...

# Correo saliente (Brevo): el código para confirmar la dirección al registrarse.
# Sin proveedor, en desarrollo el código se imprime en el registro y vuelve en la
# respuesta; en producción nadie podría confirmar su correo ni verificarse.
# BREVO_API_KEY=xkeysib-...
ORDENEX_CORREO_REMITENTE=OrdenExchange <no-responder@ordenglobal.link>

# Orígenes permitidos para la API en producción (CORS), separados por coma.
# Vacío = solo el mismo origen (la app y el panel se sirven desde este servidor).
# ORDENEX_ORIGENES=https://ordenexchange.com
# Detrás de un proxy inverso que pone X-Forwarded-For (Render y Vercel lo detectan solos):
# ORDENEX_TRAS_PROXY=1

# Cadena 5550. La tesorería es la cuenta de la plataforma: a ella deposita la
# gente y desde ella firma los retiros un operador. Sin ella no hay depósitos.
ORDENEX_RPC_URL=https://ordenglobal-rpc.com
ORDENEX_EXPLORADOR=https://ordenscan.com
# ORDENEX_TESORERIA=0x...
ORDENEX_CONFIRMACIONES=3

# Precio de referencia. 1 ORIGEN = 1/55 g de oro; 1 AUKA = 1 oz de oro; 1 AGKA = 1 oz de plata.
# Se puede cambiar después desde el panel → Precios (junto con las tasas USD→moneda local).
ORDENEX_ORO_USD_ONZA=4000
ORDENEX_PLATA_USD_ONZA=50

# Reglas de la plataforma (todas editables luego desde el panel → Configuración)
ORDENEX_COMISION_PCT=0
ORDENEX_GARANTIA_AGENTE=500
ORDENEX_MAX_ORDENES_ABIERTAS=5
ORDENEX_MIN_ORDEN_USD=5
ORDENEX_MAX_ORDEN_USD_SIN_AGENTE=5000
ORDENEX_AGENTE_ORDENES_MIN=0

# Modo demostración: usuarios ya verificados, saldos de prueba y anuncios en
# varios países. Se activa solo cuando no hay GENESIS_API_KEY y NODE_ENV no es
# production. Fuerce con 1 o 0. NUNCA en producción.
# ORDENEX_DEMO=1
