{
  "name": "ordenexchange",
  "version": "1.0.0",
  "description": "OrdenExchange — casa de cambio P2P del ecosistema Orden Global: comprar y vender ORIGEN, AUKA y AGKA con la moneda y los bancos de cada país de Latinoamérica, con custodia (escrow), chat, apelaciones y agentes de cambio verificados con Genesis ID",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "prueba": "node --import tsx --test src/pruebas/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prueba:genesis": "node --import tsx --test src/pruebas/genesis.integracion.ts",
    "generar:bancos": "node herramientas/generar-bancos.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
