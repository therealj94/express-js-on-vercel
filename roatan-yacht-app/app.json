{
  "expo": {
    "name": "Love Cloud Roatán",
    "slug": "love-cloud-roatan",
    "version": "3.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lovecloudroatan",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#072A38",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#072A38"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.lovecloud.roatanyacht",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#072A38"
      },
      "permissions": [
        "INTERNET"
      ],
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lovecloud.roatanyacht",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-video",
      "expo-audio"
    ],
    "extra": {
      "apiUrl": "https://roatan-yacht.vercel.app"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
