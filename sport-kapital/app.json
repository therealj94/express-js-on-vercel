{
  "expo": {
    "name": "Sport Kapital",
    "slug": "sport-kapital",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sportkapital",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0A0A0F",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "url": "https://u.expo.dev/106bb1b6-587f-477e-acc1-5e1d3f35fd0d"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ordenglobal.sportkapital"
    },
    "android": {
      "package": "com.ordenglobal.sportkapital",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "kotlinVersion": "1.9.24"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0F"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#00FF9C"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sport Kapital usa Face ID para proteger el acceso a tu cuenta."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "106bb1b6-587f-477e-acc1-5e1d3f35fd0d"
      }
    },
    "owner": "sportkapital"
  }
}