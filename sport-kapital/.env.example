EXPO_PUBLIC_API_FOOTBALL_KEY=tu_api_key_de_api-football.com

# Firebase (respaldo en la nube de cuentas y datos del usuario).
# Crea un proyecto gratis en https://console.firebase.google.com, activa
# Authentication > Email/Password y Firestore Database, y pega aquí los
# valores de "Configuración del proyecto > Tus apps > SDK de Firebase".
# Si dejas esto vacío, la app sigue funcionando 100% local (sin cuentas ni login).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
