{
  "expo": {
    "name": "Orden Global",
    "slug": "orden-global",
    "version": "1.33.0",
    "owner": "ordenglobal",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "og",
      "vetawallet"
    ],
    "userInterfaceStyle": "dark",
    "backgroundColor": "#021B1C",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#010D0E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ordenglobal.vetawallet",
      "infoPlist": {
        "NSCameraUsageDescription": "Veta Wallet usa la cámara para escanear códigos QR de direcciones de billetera.",
        "NSPhotoLibraryUsageDescription": "Veta Wallet accede a tus fotos para que subas la imagen de tu pasaporte Genesis ID.",
        "NSFaceIDUsageDescription": "Veta Wallet usa Face ID para desbloquear tu billetera y proteger tus fondos.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Veta Wallet guarda en tus fotos el código QR de tu dirección cuando eliges descargarlo."
      },
      "buildNumber": "70",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": []
      },
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      }
    },
    "android": {
      "package": "com.ordenglobal.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#021B1C"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ],
      "versionCode": 70,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#010D0E"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Veta Wallet usa la cámara para escanear códigos QR de direcciones de billetera."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9A961"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Veta Wallet accede a tus fotos para que subas la imagen de tu pasaporte Genesis ID.",
          "cameraPermission": "Veta Wallet usa la cámara para escanear códigos QR y capturar tu pasaporte."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Orden Global usa el micrófono para que NEXUS te escuche cuando le hablas.",
          "speechRecognitionPermission": "Orden Global convierte tu voz en órdenes para NEXUS, tu asistente.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3017e984-a8ac-479c-8b75-33f8b8e69b25"
      },
      "genesisUrl": "https://genesis-id.onrender.com",
      "telemetriaClave": "gidp_veta-wallet_98cwxS8AnbUIRAEr",
      "mensajesApi": "https://cerebro.ordenscan.com/mensajes"
    },
    "updates": {
      "url": "https://u.expo.dev/3017e984-a8ac-479c-8b75-33f8b8e69b25"
    }
  }
}