# Nada compilado ni descargado entra al repositorio.
node_modules/
dist/
artifacts/
cache/
typechain-types/
coverage/
*.tsbuildinfo

# Las corridas de evidencia se generan; se conserva la plantilla, no la salida.
evidence/corridas/

# Por si acaso: aquí nunca debe haber un secreto, y si alguien crea uno por
# error, que al menos no se suba.
.env
.env.*
*.key
*.pem

# Los informes de auditoria se guardan, pero no los temporales de Codex.
.codex/

# El compilador vendorizado NO se versiona: son 15,7 MB que quedarían en la
# historia de git para siempre. La garantía la da la huella SHA-256 fijada en
# contracts/compilador/compilador.json, que se comprueba antes de compilar, y
# `node contracts/compilador/preparar.mjs` lo reconstruye en un paso.
contracts/compilador/solc-*
