# Nada compilado ni descargado entra al repositorio.
node_modules/
dist/
# Complemento Java de la red cerrada: la salida de Gradle no se versiona.
red/filtro-besu/build/
red/filtro-besu/.gradle/
artifacts/
cache/
typechain-types/
coverage/
*.tsbuildinfo

# Las corridas de evidencia se generan; se conserva la plantilla, no la salida.
evidence/corridas/

# Por si acaso: aquí nunca debe haber un secreto, y si alguien crea uno por
# error, que al menos no se suba.
.env
.env.*
*.key
*.pem

# Los informes de auditoria se guardan, pero no los temporales de Codex.
.codex/

# El compilador vendorizado NO se versiona: son 15,7 MB que quedarían en la
# historia de git para siempre. La garantía la da la huella SHA-256 fijada en
# contracts/compilador/compilador.json, que se comprueba antes de compilar, y
# `node contracts/compilador/preparar.mjs` lo reconstruye en un paso.
contracts/compilador/solc-*

# Salidas de migracion-410: direcciones y saldos de personas. Los scripts las
# escriben FUERA del repositorio y se niegan a escribir dentro; esto es la segunda
# barrera por si alguien lo fuerza con PERMITIR_SALIDA_EN_REPO. Los ejemplos
# versionados de sintetico/ llevan otros nombres (…-sintetico.json).
migracion-410/**/censo-tokens.json
migracion-410/**/censo-tokens.csv
migracion-410/**/padron-titulares.csv
migracion-410/**/censo-ondk.json
migracion-410/**/padron-*.json
migracion-410/**/padron-*.csv
migracion-410/**/raices-merkle.json
migracion-410/**/lote-*.json
migracion-410/**/lote-*.csv
migracion-410/**/simulacion-*.json
